[TEMPLATE]
# Optional: enables the "Live AI" expert mode.
# Get a free key at https://console.groq.com — without it the app runs
# fully in scripted (mock) mode.
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the Groq model used in live mode.
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: credits given to each new visitor (the billing tier's seed).
# Defaults to 300 — enough for three 100-credit missions. Set 0 to demo the
# "insufficient balance" path on the very first mission.
# DEMO_USER_BALANCE=300
